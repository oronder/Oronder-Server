# Copy this file to .env on your server (same directory as docker-compose.yml).
# Nothing here is required for local development: with no DISCORD_TOKEN the
# server runs in fake-Discord mode, and `uv run python scripts/dev.py`
# bootstraps its own Postgres. See TESTING.md.

# --------------------
# Discord (leave DISCORD_TOKEN empty to run without Discord)
# --------------------
DISCORD_TOKEN=
DISCORD_CLIENT_SECRET=
API_URL=https://api.example.com

# --------------------
# Configurable
# --------------------
UVICORN_PORT=39054
LOG_LEVEL=INFO
# Force fake-Discord mode even when a token is set: FAKE_DISCORD=1
# Custom fake guild layout: FAKE_DISCORD_SEED=/path/to/seed.json

# --------------------
# Database (DATABASE_URL wins; otherwise composed from POSTGRES_*)
# --------------------
POSTGRES_DB=oronder
POSTGRES_USER=oronder
POSTGRES_PASSWORD=change_me
POSTGRES_HOSTNAME=oronder-db
POSTGRES_PORT=5432
#DATABASE_URL=postgresql://user:password@host:5432/db

# --------------------
# Shared-key endpoints (each endpoint is disabled while its key is unset;
# generate with: python -c "import secrets; print(secrets.token_urlsafe())")
# --------------------
ADMIN_API_KEY=
UPDATE_DISCORD_KEY=

# --------------------
# Backblaze B2 - DB Backups (optional)
# --------------------
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_NOTIFICATION_WEBHOOK=

# --------------------
# Uptime - GitHub API (optional)
# --------------------
GITHUB_UPTIME_PAT=
GITHUB_UPTIME_URL=

# --------------------
# Wiki.js - (optional)
# --------------------
WIKIJS_TOKEN=
WIKIJS_URL=https://wiki.example.com/graphql
