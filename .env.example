# Copy this file to .env on your server (same directory as docker-compose.yml)

# --------------------
# Required
# --------------------
# Discord bot token
DISCORD_TOKEN=
DISCORD_CLIENT_SECRET=
API_URL=https://api.example.com


# Log verbosity for the app (e.g., DEBUG, INFO, WARNING)
LOG_LEVEL=INFO

# Base URL serving the 5e JSON data used by /lookup, /action and the item
# shop. Optional: files already cached in ./data are used first, and when
# neither is available the commands that need that data are not registered.
# Must end in a slash.
DND5E_DATA_SOURCE=

# Which sourcebooks, classes and item ages are surfaced. Comma-separated, and
# matched verbatim against the codes in the data, so case matters ("PHB",
# "GoS", "futuristic"). Leave blank for the defaults below.
#
# Keep the sources oldest-to-newest: where two books print the same spell the
# later one wins.
#
# A few books appear under more than one code; naming two codes for the same
# book logs an error and keeps the later one.
#   DND5E_ALLOWED_SOURCES: XGE,GoS,EGW,TCE,VRGR,FTD,BGG,CoA,BMT,XPHB,XDMG,FRHoF,LFL,EFA,RHW,AU
#   DND5E_ALLOWED_CLASSES: Artificer,Bard,Cleric,Druid,Monk,Paladin,Ranger,Sorcerer,Warlock,Wizard
#   DND5E_DISALLOWED_AGES: futuristic,renaissance,modern
DND5E_ALLOWED_SOURCES=
DND5E_ALLOWED_CLASSES=
DND5E_DISALLOWED_AGES=

# Port uvicorn binds inside the container, and the port published on the host
UVICORN_PORT=56427
# Host address the port is published on. Keep 127.0.0.1 and put a TLS reverse
# proxy (Caddy, nginx) in front. Set 0.0.0.0 only if nothing else will serve
# HTTPS -- the API then takes auth tokens over plain HTTP.
PUBLISH_ADDRESS=127.0.0.1

# --------------------
# Database
# --------------------
# These configure the Postgres container
POSTGRES_USER=oronder
POSTGRES_PASSWORD=change_me_or_not_idk
POSTGRES_DB=oronder
# Don't modify directly!
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@oronder-db:5432/${POSTGRES_DB}

# --------------------
# Backblaze B2 - DB Backups (optional)
# --------------------
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_NOTIFICATION_WEBHOOK=

# --------------------
# Uptime - GitHub API (optional)
# --------------------
GITHUB_UPTIME_PAT=
GITHUB_UPTIME_URL=

# --------------------
# Deploys - Discord webhook for rollback-guard alerts (optional)
# --------------------
DEPLOY_NOTIFICATION_WEBHOOK=

# --------------------
# Admin API (optional)
# --------------------
# Authorizes GET /admin/bot/info, which lists every guild with its owner and
# Foundry hostname. Leave unset to disable the endpoint entirely.
ADMIN_API_KEY=

# --------------------
# Foundry module release announcements (optional)
# --------------------
# Shared secret the module's release pipeline sends to POST /update_discord to
# post a changelog to Discord. Leave unset on a self-hosted instance and the
# endpoint rejects every request.
UPDATE_DISCORD_KEY=

# --------------------
# Instance-specific Discord ids (all optional)
# --------------------
# Leave these unset on a self-hosted instance: each one switches on a feature
# of the official Oronder deployment, and unset means that feature is off.
# Lists are comma-separated.

# Guild whose supporter / beta-tester roles grant subscriptions
HOME_GUILD_ID=
SUPPORTER_ROLE_ID=
BETA_TESTER_ROLE_ID=
# Guild owners always exempt from subscription checks
SUBSCRIPTION_EXEMPT_USER_IDS=
# Users who may run /superadmin and edit any GM's missions
SUPER_ADMIN_USER_IDS=
# Guilds /superadmin is registered in (unset: registered nowhere)
SUPER_ADMIN_GUILD_IDS=
# Guild owners who get raw unhandled Foundry payloads by DM, for debugging
DEBUG_DM_USER_IDS=
# Channel that module release announcements (POST /update_discord) go to
CHANGELOG_CHANNEL_ID=
# Guilds whose characters are mirrored to Wiki.js (needs WIKIJS_URL/TOKEN)
WIKIJS_GUILD_IDS=

# --------------------
# Wiki.js - (optional)
# --------------------
WIKIJS_TOKEN=
WIKIJS_URL=https://wiki.example.com/graphql
